---
// Latin faces (Fraunces, Instrument Sans, JetBrains Mono) are @font-face rules in global.css,
// served from /public/fonts. Loaded on every page for the endonym language switcher (العربية, 한국어):
// unicode-range subsetting means only the needed glyph subsets download.
import '@fontsource/noto-naskh-arabic/400.css';
import '@fontsource/noto-sans-kr/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, localePath } from '../i18n';
import { SITE_URL, OWNER, EMAIL, LINKEDIN_URL } from '../config';
import CorridorLine from '../components/CorridorLine.astro';

interface Props {
  locale: string;
  title: string;
  description: string;
  /** Locale-less path of this page, e.g. '/advisory/'. */
  path: string;
  /** Locales in which this page exists (including the current one). */
  alternates?: string[];
  active?: 'advisory' | 'research' | 'about' | 'contact';
}

const { locale, title, description, path, alternates = ['en'], active } = Astro.props;
const t = getDict(locale);
const canonical = `${SITE_URL}${localePath(locale, path)}`;

// Structured data. SSRN is identified as plain text, never as a URL (site policy).
import en from '../i18n/en';
const personId = `${SITE_URL}/#person`;
const orgId = `${SITE_URL}/#org`;
const ldGraph: object[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: OWNER,
    url: SITE_URL,
    jobTitle: 'Energy infrastructure executive and independent advisor',
    image: `${SITE_URL}/portrait.jpg`,
    knowsAbout: [
      'Enterprise risk governance',
      'Energy infrastructure',
      'Cross-border pipeline systems',
      'Asset integrity',
      'Behavioral prediction in organisations',
      'Human-AI teams',
    ],
    address: { '@type': 'PostalAddress', addressLocality: 'Vienna', addressCountry: 'AT' },
    sameAs: [LINKEDIN_URL],
    worksFor: { '@id': orgId },
  },
  {
    '@type': 'Organization',
    '@id': orgId,
    name: OWNER,
    url: SITE_URL,
    email: EMAIL,
    vatID: 'ATU69787028',
    address: {
      '@type': 'PostalAddress',
      postalCode: '1100',
      addressLocality: 'Wien',
      addressCountry: 'AT',
    },
  },
];
if (path === '/about/') {
  ldGraph.push({ '@type': 'ProfilePage', mainEntity: { '@id': personId } });
}
if (path === '/research/') {
  for (const paper of en.research!.papers) {
    ldGraph.push({
      '@type': 'ScholarlyArticle',
      headline: paper.title,
      author: { '@id': personId },
      datePublished: '2026-08',
      identifier: paper.ssrnRecordLabel.replace('SSRN Abstract ID: ', 'SSRN '),
      url: `${SITE_URL}${paper.pdfHref}`,
      encodingFormat: 'application/pdf',
      mainEntityOfPage: canonical,
      inLanguage: 'en',
    });
  }
}
const ldJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': ldGraph });
const ogLocales: Record<string, string> = {
  en: 'en_US',
  de: 'de_AT',
  it: 'it_IT',
  ro: 'ro_RO',
  es: 'es_ES',
  ar: 'ar_AR',
  ko: 'ko_KR',
};
---

<!doctype html>
<html lang={locale} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((l) => (
        <link rel="alternate" hreflang={l} href={`${SITE_URL}${localePath(l, path)}`} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${path}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={OWNER} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocales[locale] ?? 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1b2231" />
    <script type="application/ld+json" is:inline set:html={ldJson} />
    <!-- Cloudflare Web Analytics --><script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "678b0e29ba78415f942765737809536d"}'></script><!-- End Cloudflare Web Analytics -->
    <!-- Umami Analytics: cookieless; page views plus tagged events (Paper Download, Contact Click, LinkedIn Click). -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="8b899c12-cb66-4817-8b37-c9b8c899ff9c"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header locale={locale} path={path} alternates={alternates} active={active} />
    <main id="main">
      <slot />
    </main>
    {
      path !== '/' && (
        <div class="corridor-divider" aria-hidden="true">
          <CorridorLine />
        </div>
      )
    }
    <Footer locale={locale} path={path} alternates={alternates} />
    <script>
      // Handoff section 4: reveal, tilt, magnetic, counters. No dependencies, no network.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      function initReveal() {
        const map = new Map<Element, Element>();
        document.querySelectorAll('.reveal, .mask-reveal').forEach((el) => {
          // An element clipped to zero is invisible to IntersectionObserver, so watch its parent.
          const watched = el.classList.contains('mask-reveal') && el.parentElement ? el.parentElement : el;
          map.set(watched, el);
        });
        if (!('IntersectionObserver' in window)) {
          map.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              map.get(e.target)?.classList.add('is-in');
              io.unobserve(e.target);
            }),
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        map.forEach((_, w) => io.observe(w));
      }

      function initTilt() {
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            el.style.setProperty('--mx', x * 100 + '%');
            el.style.setProperty('--my', y * 100 + '%');
            if (!reduce) {
              el.style.setProperty('--ry', (x - 0.5) * 6 + 'deg');
              el.style.setProperty('--rx', (0.5 - y) * 6 + 'deg');
            }
          });
          el.addEventListener('pointerleave', () => {
            el.style.setProperty('--rx', '0deg');
            el.style.setProperty('--ry', '0deg');
          });
        });
      }

      function initMagnetic(strength = 0.22) {
        if (reduce) return;
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * strength}px, ${(e.clientY - r.top - r.height / 2) * strength}px)`;
          });
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
          });
        });
      }

      function initCounters() {
        if (reduce) return;
        // Intermediate values follow the page language (8,5 in German, 8.500 in Spanish), always
        // with Latin digits as the site's copy uses; the exact final text is restored at the end.
        const lang = (document.documentElement.lang || 'en') + '-u-nu-latn';
        const formatter = (dec: number) => {
          const opts = { minimumFractionDigits: dec, maximumFractionDigits: dec };
          try {
            return new Intl.NumberFormat(lang, { ...opts, useGrouping: 'always' as never });
          } catch {
            return new Intl.NumberFormat(lang, opts);
          }
        };
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const to = parseFloat(el.dataset.count || '');
          if (Number.isNaN(to)) return;
          const dec = +(el.dataset.decimals || 0);
          const fmt = formatter(dec);
          const pre = el.dataset.prefix || '';
          const suf = el.dataset.suffix || '';
          const final = el.textContent;
          const io = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) return;
            io.disconnect();
            const t0 = performance.now();
            const step = (t: number) => {
              const p = Math.min(1, (t - t0) / 1600);
              const v = to * (1 - Math.pow(1 - p, 3));
              el.textContent = p < 1 ? pre + fmt.format(v) + suf : final;
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
          io.observe(el);
        });
      }

      initReveal();
      initTilt();
      initMagnetic();
      initCounters();
    </script>
  </body>
</html>

<style>
  .corridor-divider {
    position: relative;
    height: 90px;
    overflow: hidden;
    margin-top: 24px;
  }

  @media (max-width: 820px) {
    .corridor-divider {
      height: 64px;
    }
  }
</style>
