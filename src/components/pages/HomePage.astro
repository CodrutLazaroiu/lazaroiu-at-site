---
import { getDict, localePath } from '../../i18n';
import en from '../../i18n/en';
import { CTA_MAILTO } from '../../config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getDict(locale);

// Italic accent on the tail of the headline; locales without an accent render plain.
const accent = t.home.h1Accent;
const h1Lead = accent && t.home.h1.endsWith(accent) ? t.home.h1.slice(0, -accent.length) : t.home.h1;
// Figures band falls back to English until the locale pass.
const figures = t.home.figures ?? en.home.figures!;
---

<section class="hero">
  <!-- 3.7 corridor lines. All four paths stay in the top band of the viewBox so they never
       cross the headline, intro or buttons; on narrow screens the SVG is a band above the text. -->
  <svg class="corridors" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path class="base" d="M-50 240 C 220 200, 420 286, 680 210 S 1040 120, 1500 160"></path>
    <path class="flow" style="animation-duration:14s;opacity:.75;stroke-width:1.6" d="M-50 240 C 220 200, 420 286, 680 210 S 1040 120, 1500 160"></path>
    <path class="base" d="M-50 150 C 200 190, 400 80, 650 120 S 1000 60, 1500 40"></path>
    <path class="flow" style="animation-duration:18s;opacity:.65;stroke-width:1.6" d="M-50 150 C 200 190, 400 80, 650 120 S 1000 60, 1500 40"></path>
    <path class="base" d="M-50 80 C 300 60, 500 20, 760 50 S 1100 10, 1500 30"></path>
    <path class="flow" style="animation-duration:22s;opacity:.55;stroke-width:1.6" d="M-50 80 C 300 60, 500 20, 760 50 S 1100 10, 1500 30"></path>
    <path class="base" d="M300 290 C 500 270, 700 180, 900 190 S 1250 230, 1500 120"></path>
    <path class="flow" style="animation-duration:26s;opacity:.45" d="M300 290 C 500 270, 700 180, 900 190 S 1250 230, 1500 120"></path>
    <circle cx="680" cy="210" r="3" fill="var(--copper)"><animate attributeName="r" values="2;5;2" dur="3s" repeatCount="indefinite"></animate></circle>
    <circle cx="650" cy="120" r="3" fill="var(--copper)"><animate attributeName="r" values="2;5;2" dur="4s" repeatCount="indefinite"></animate></circle>
  </svg>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-content container">
    <p class="label rise" style="--i:0"><span class="full">{t.home.eyebrow}</span><span class="short">{t.home.eyebrowShort}</span></p>
    <h1 class="rise" style="--i:1">{h1Lead}{accent && <em class="accent">{accent}</em>}</h1>
    <p class="lede rise" style="--i:2">{t.home.lede}</p>
    <p class="cta-row rise" style="--i:3">
      <a class="btn btn--solid" data-magnetic href={CTA_MAILTO} data-umami-event="Contact Click">{t.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
    </p>
    <p class="product-line rise" style="--i:4">{t.productCaption}</p>
  </div>
</section>

<section class="figures container" aria-label={figures.map((f) => `${f.value} ${f.label}`).join(' · ')}>
  <ul class="figures-list" role="list">
    {
      figures.map((f, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <span
            class:list={['figure-value', { 'figure-value--text': !f.count }]}
            data-count={f.count}
            data-decimals={f.decimals}
            data-prefix={f.prefix}
            data-suffix={f.suffix}
          >
            {f.value}
          </span>
          <span class="label">{f.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="pillars container" aria-label={`${t.nav.advisory} · ${t.nav.research} · ${t.nav.about}`}>
  {
    t.home.pillars.map((pillar, i) => (
      <div class="card pillar reveal" data-tilt style={`--i:${i}`}>
        <div>
          <p class="num mono">{pillar.num}</p>
          <a class="card-title link-draw" href={localePath(locale, pillar.href)}>
            {pillar.title}
          </a>
          <p class="card-text">{pillar.text}</p>
        </div>
        <a class="card-cta mono" href={localePath(locale, pillar.href)} tabindex="-1" aria-hidden="true">
          {pillar.cta}
        </a>
      </div>
    ))
  }
</section>

<!-- 3.13 paper-tone reading section for the papers -->
<section class="papers paper-tone">
  <ul class="paper-list container" role="list">
    {
      t.home.papers.map((paper, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <p class="label meta paper-eyebrow">{paper.eyebrow}</p>
          <h2 class="paper-title">{paper.title}</h2>
          <p class="paper-thesis">{paper.thesis}</p>
          <a class="paper-cta mono link-draw" href={localePath(locale, paper.href)}>
            <span class="full">{paper.cta}</span>
            <span class="short">{paper.ctaShort}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .full {
    display: inline;
  }

  .short {
    display: none;
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: min(100svh, 56rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding: 8rem 0 4rem;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background: var(--hero-veil);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: calc(var(--container) + 2 * var(--pad-x));
  }

  h1 {
    font-size: var(--step-hero);
    line-height: 1.02;
    margin: 1.25rem 0 0;
    max-width: 60rem;
    text-wrap: balance;
  }

  .lede {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted-hero);
    max-width: 40rem;
    margin: 1.75rem 0 0;
  }

  .cta-row {
    margin: 2rem 0 0;
  }

  .product-line {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--fg-muted);
    font-style: italic;
    max-width: 40rem;
    margin: 1.5rem 0 0;
  }

  /* ---------- figures band ---------- */
  .figures {
    border-block: 1px solid var(--line);
    padding-block: 2.75rem;
  }

  .figures-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .figures-list li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .figure-value {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .figure-value--text {
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: 0;
    padding-top: 0.35rem;
  }

  /* ---------- pillars ---------- */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    padding-block: 4rem 0;
  }

  .pillar {
    padding: 2rem;
    min-height: 17rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .num {
    font-size: 0.75rem;
    color: var(--copper);
  }

  .card-title {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin: 1rem 0 0.5rem;
  }

  .card-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
  }

  .card-cta {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--copper);
    margin-top: 1.5rem;
    text-decoration: none;
  }

  a.card-cta:hover {
    text-decoration: underline;
  }

  /* Path fragments are LTR; keep their character order under RTL layout. */
  :global([dir='rtl']) .card-cta {
    direction: ltr;
    text-align: end;
  }

  /* ---------- papers (paper tone) ---------- */
  .papers {
    margin-top: 5rem;
    padding-block: 2rem 4rem;
  }

  .paper-list {
    list-style: none;
    margin: 0;
  }

  .paper-list li {
    border-top: 1px solid oklch(0.2 0.02 255 / 15%);
    padding: 2.5rem 0;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 0.5rem 3rem;
    align-items: start;
  }

  .paper-eyebrow {
    grid-column: 1 / -1;
  }

  .paper-title {
    font-size: 1.75rem;
    line-height: 1.2;
    margin: 0.5rem 0 0;
    text-wrap: pretty;
    transition: color 0.5s;
  }

  .paper-list li:hover .paper-title {
    color: var(--copper);
  }

  .paper-thesis {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--paper-muted);
    margin: 0.75rem 0 0;
  }

  .paper-cta {
    grid-column: 1;
    justify-self: start;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--paper-fg);
    margin-top: 1.25rem;
  }

  @media (max-width: 820px) {
    .full {
      display: none;
    }

    .short {
      display: inline;
    }

    /* The corridor lines become a band above the text, so they can never cross it. */
    .hero {
      min-height: 0;
      padding: 15rem 0 2.5rem;
    }

    /* The paths live in the top third of the viewBox; shift them into the band's middle. */
    .corridors {
      height: 14rem;
      transform: translateY(38%);
    }

    :global([dir='rtl']) .corridors {
      transform: scaleX(-1) translateY(38%);
    }

    .hero-veil {
      height: 14rem;
      background: linear-gradient(to bottom, var(--bg) 0%, transparent 12%, transparent 72%, var(--bg) 100%);
    }

    h1 {
      line-height: 1.06;
      margin-top: 1rem;
    }

    .lede {
      font-size: 0.9375rem;
      margin-top: 1.25rem;
    }

    .product-line {
      font-size: 0.75rem;
    }

    .figures {
      padding-block: 2rem;
    }

    .figures-list {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .pillars {
      grid-template-columns: 1fr;
      gap: 0.875rem;
      padding-top: 2.5rem;
    }

    .pillar {
      padding: 1.5rem;
      min-height: 0;
      gap: 1.25rem;
    }

    .card-cta {
      display: none;
    }

    .papers {
      margin-top: 3rem;
      padding-block: 1rem 2.5rem;
    }

    .paper-list li {
      grid-template-columns: 1fr;
      padding: 1.75rem 0;
      gap: 0.25rem;
    }

    .paper-title {
      font-size: 1.375rem;
    }

    .paper-thesis {
      font-size: 1rem;
    }
  }
</style>
