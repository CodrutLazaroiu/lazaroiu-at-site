---
import CorridorLine from '../CorridorLine.astro';
import { getDict, localePath } from '../../i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow"><span class="full">{t.home.eyebrow}</span><span class="short">{t.home.eyebrowShort}</span></p>
    <h1>{t.home.h1}</h1>
    <p class="lede">{t.home.lede}</p>
  </div>
</section>

<!-- The corridor line lives in its own band so it never crosses text. -->
<div class="corridor-band" aria-hidden="true">
  <CorridorLine />
</div>

<section class="pillars container" aria-label={`${t.nav.advisory} · ${t.nav.research} · ${t.nav.about}`}>
  {
    t.home.pillars.map((pillar) => (
      <div class="card">
        <p class="num mono">{pillar.num}</p>
        <a class="card-title" href={localePath(locale, pillar.href)}>
          {pillar.title}
        </a>
        <p class="card-text">{pillar.text}</p>
        <p class="card-cta mono" aria-hidden="true">
          {pillar.cta}
        </p>
      </div>
    ))
  }
</section>

{
  t.home.papers.map((paper) => (
    <section class="paper">
      <p class="eyebrow paper-eyebrow">{paper.eyebrow}</p>
      <p class="paper-title">{paper.title}</p>
      <p class="paper-thesis">{paper.thesis}</p>
      <a class="paper-cta mono" href={localePath(locale, paper.href)}>
        <span class="full">{paper.cta}</span>
        <span class="short">{paper.ctaShort}</span>
      </a>
    </section>
  ))
}

<style>
  .full {
    display: inline;
  }

  .short {
    display: none;
  }

  .hero {
    position: relative;
    padding: 96px var(--pad-x) 36px;
  }

  .hero-inner {
    position: relative;
  }

  .corridor-band {
    position: relative;
    height: 140px;
    overflow: hidden;
  }

  h1 {
    font-size: 52px;
    font-weight: 600;
    line-height: 1.14;
    margin: 18px 0 0;
    max-width: 780px;
    text-wrap: pretty;
  }

  .lede {
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted-hero);
    max-width: 640px;
    margin: 22px 0 0;
  }

  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
  }

  .card {
    border: 1px solid var(--line);
    background: var(--card);
    padding: 26px 26px 30px;
  }

  .num {
    font-size: 11.5px;
    color: var(--gold);
  }

  .card-title {
    display: block;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    margin: 14px 0 8px;
  }

  .card-title:hover {
    color: var(--gold);
  }

  .card-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }

  .card-cta {
    font-size: 12px;
    color: var(--gold);
    margin-top: 16px;
  }

  /* Path fragments are LTR; keep their character order under RTL layout. */
  :global([dir='rtl']) .card-cta {
    direction: ltr;
    text-align: end;
  }

  .paper {
    margin: 56px var(--pad-x) 0;
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    padding: 34px 40px 38px;
  }

  .paper + .paper {
    margin-top: 20px;
  }

  .paper-eyebrow {
    letter-spacing: 0.2em;
  }

  .paper-title {
    font-size: 27px;
    font-weight: 600;
    line-height: 1.3;
    margin: 14px 0 10px;
    max-width: 840px;
    text-wrap: pretty;
  }

  .paper-thesis {
    font-style: italic;
    font-size: 17px;
    color: var(--text-body);
  }

  .paper-cta {
    display: inline-block;
    font-size: 12.5px;
    color: var(--gold);
    margin-top: 18px;
    text-decoration: none;
  }

  .paper-cta:hover {
    text-decoration: underline;
  }

  .paper + :global(footer),
  .paper {
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .full {
      display: none;
    }

    .short {
      display: inline;
    }

    .hero {
      padding: 48px var(--pad-x) 20px;
    }

    .corridor-band {
      height: 90px;
    }

    h1 {
      font-size: 31px;
      line-height: 1.2;
      margin-top: 14px;
    }

    .lede {
      font-size: 14px;
      margin-top: 16px;
    }

    .pillars {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .card {
      padding: 20px 20px 24px;
    }

    .num {
      font-size: 11px;
    }

    .card-title {
      font-size: 16px;
      margin: 10px 0 6px;
    }

    .card-text {
      font-size: 13px;
    }

    .card-cta {
      display: none;
    }

    .paper {
      margin: 24px var(--pad-x) 0;
      padding: 24px 22px 28px;
    }

    .paper + .paper {
      margin-top: 14px;
    }

    .paper-eyebrow {
      letter-spacing: 0.18em;
    }

    .paper-title {
      font-size: 18px;
      line-height: 1.35;
      margin: 12px 0 8px;
    }

    .paper-thesis {
      font-size: 14.5px;
    }

    .paper-cta {
      font-size: 11.5px;
      margin-top: 14px;
    }
  }
</style>

<!-- Footer spacing per render: 64px above footer on desktop, 32px mobile -->
<div class="footer-gap" aria-hidden="true"></div>
<style>
  .footer-gap {
    height: 64px;
  }

  @media (max-width: 820px) {
    .footer-gap {
      height: 32px;
    }
  }
</style>
