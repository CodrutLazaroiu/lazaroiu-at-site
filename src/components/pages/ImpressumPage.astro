---
import { EMAIL, OWNER } from '../../config';
---

<section class="legal container">
  <div class="block" lang="de">
    <p class="eyebrow">Impressum</p>
    <h1>Impressum</h1>
    <p class="note">Angaben gemäß §5 E-Commerce-Gesetz (ECG)</p>
    <dl>
      <div class="row">
        <dt>Diensteanbieter</dt>
        <dd>{OWNER}</dd>
      </div>
      <div class="row">
        <dt>Anschrift</dt>
        <dd>Laaer-Berg-Strasse 49, 1100 Wien, Österreich</dd>
      </div>
      <div class="row">
        <dt>Kontakt</dt>
        <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
      </div>
      <div class="row">
        <dt>Unternehmensgegenstand</dt>
        <dd>Unternehmensberatung</dd>
      </div>
      <div class="row">
        <dt>UID-Nummer</dt>
        <dd>ATU69787028</dd>
      </div>
    </dl>
  </div>

  <div class="block mirror" lang="en">
    <h2>Legal notice (English)</h2>
    <p class="note">Information pursuant to §5 of the Austrian E-Commerce Act (ECG)</p>
    <dl>
      <div class="row">
        <dt>Service provider</dt>
        <dd>{OWNER}</dd>
      </div>
      <div class="row">
        <dt>Address</dt>
        <dd>Laaer-Berg-Strasse 49, 1100 Vienna, Austria</dd>
      </div>
      <div class="row">
        <dt>Contact</dt>
        <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
      </div>
      <div class="row">
        <dt>Business purpose</dt>
        <dd>Management consulting</dd>
      </div>
      <div class="row">
        <dt>VAT ID (UID)</dt>
        <dd>ATU69787028</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .legal {
    padding: 64px var(--pad-x) 96px;
    max-width: 820px;
  }

  h1 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    margin: 14px 0 10px;
  }

  h2 {
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 10px;
  }

  .note {
    font-size: 13.5px;
    color: var(--muted);
    margin: 0 0 24px;
  }

  .mirror {
    margin-top: 56px;
    border-top: 1px solid var(--line-strong);
    padding-top: 40px;
  }

  dl {
    margin: 0;
  }

  .row {
    border-top: 1px solid var(--line-strong);
    padding: 13px 0;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
  }

  .row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  dt {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    padding-top: 2px;
  }

  dd {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-body);
    margin: 0;
  }

  dd a {
    color: var(--text);
  }

  @media (max-width: 820px) {
    .legal {
      padding: 40px var(--pad-x) 56px;
    }

    h1 {
      font-size: 27px;
      line-height: 1.2;
      margin: 12px 0 8px;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    dt {
      font-size: 10px;
    }

    dd {
      font-size: 13.5px;
    }

    .mirror {
      margin-top: 40px;
      padding-top: 28px;
    }
  }
</style>
