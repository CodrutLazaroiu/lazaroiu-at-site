---
import { Picture } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';
import { getDict } from '../../i18n';
import en from '../../i18n/en';
import { CTA_MAILTO } from '../../config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getDict(locale);

// 3.9 counters on the About figures. A row gets a counter only where it contains one of the
// locale's own figure strings (the same ones the Home figures band shows), so the HTML keeps the
// exact final text and reads correctly without JS or with reduced motion.
const escape = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const counterFigures = (t.home.figures ?? en.home.figures!).filter((f) => f.count);
const withCounters = (text: string) =>
  counterFigures.reduce((html, f) => {
    const attrs = [
      `data-count="${f.count}"`,
      f.decimals && `data-decimals="${f.decimals}"`,
      f.prefix && `data-prefix="${escape(f.prefix)}"`,
      f.suffix && `data-suffix="${escape(f.suffix)}"`,
    ]
      .filter(Boolean)
      .join(' ');
    return html.split(escape(f.value)).join(`<span ${attrs}>${escape(f.value)}</span>`);
  }, escape(text));
---

<section class="about container">
  <div class="portrait-wrap">
    <div class="portrait mask-reveal">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[360, 720]}
        sizes="(max-width: 820px) calc(100vw - 44px), 360px"
        loading="eager"
        fetchpriority="high"
        alt={t.about.portraitAlt}
      />
    </div>
    <p class="caption mono">{t.about.portraitCaption}</p>
  </div>
  <div class="content">
    <p class="label reveal" style="--i:0">{t.about.eyebrow}</p>
    <h1 class="reveal" style="--i:1">{t.about.h1}</h1>
    <p class="lede reveal" style="--i:2">{t.about.lede}</p>
    <ol class="timeline rows" role="list">
      {
        t.about.rows.map((row, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <span class="label row-label">{row.label}</span>
            <p class="row-text" set:html={withCounters(row.text)} />
          </li>
        ))
      }
    </ol>
    <p class="cta-row reveal" style={`--i:${t.about.rows.length}`}>
      <a class="btn btn--solid" data-magnetic href={CTA_MAILTO} data-umami-event="Contact Click">{t.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .about {
    padding: 4rem var(--pad-x) 4.5rem;
    display: grid;
    grid-template-columns: 22.5rem minmax(0, 1fr);
    gap: 3.75rem;
    align-items: start;
  }

  /* 3.6 portrait: 4/5 window, head fully in frame with air above, jacket visible. */
  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line-img);
    border-radius: var(--radius);
  }

  .portrait :global(picture),
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait :global(img) {
    object-fit: cover;
    object-position: 50% 10%;
    filter: grayscale(1);
    transition:
      filter 1s,
      transform 1s;
  }

  .portrait:hover :global(img) {
    filter: none;
    transform: scale(1.05);
  }

  .caption {
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-top: 0.75rem;
  }

  h1 {
    font-size: var(--step-h2);
    line-height: 1.1;
    margin: 1rem 0 0.75rem;
  }

  .lede {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0 0 2rem;
    max-width: 40rem;
  }

  .rows {
    margin: 0;
  }

  .row-label {
    padding-top: 0.2rem;
  }

  .row-text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-body);
    margin: 0;
    max-width: 40rem;
  }

  .row-text :global([data-count]) {
    font-variant-numeric: tabular-nums;
  }

  .cta-row {
    margin: 2.5rem 0 0;
  }

  @media (max-width: 820px) {
    .about {
      padding: 2.5rem var(--pad-x) 0;
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* Mobile render order: label, h1, lede, portrait, timeline */
    .portrait-wrap {
      order: 2;
    }

    .content {
      display: contents;
    }

    .content > .label,
    .content > h1,
    .content > .lede {
      order: 1;
    }

    .content > .rows,
    .content > .cta-row {
      order: 3;
    }

    h1 {
      margin: 0.75rem 0 0.5rem;
    }

    .lede {
      font-size: 0.9375rem;
      margin-bottom: 1.5rem;
    }

    .caption {
      margin: 0.5rem 0 1.75rem;
    }

    .timeline li {
      padding-block: 1.25rem;
    }

    .timeline li::before {
      top: 1.6rem;
    }

    .row-text {
      font-size: 0.9375rem;
    }

    .cta-row {
      margin: 2rem 0 2.5rem;
    }
  }
</style>
