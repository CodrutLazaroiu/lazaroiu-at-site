---
import { getDict } from '../../i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section class="head container">
  <p class="label rise" style="--i:0">{t.advisory.eyebrow}</p>
  <h1 class="rise" style="--i:1">{t.advisory.h1}</h1>
  <p class="lede rise" style="--i:2">{t.advisory.lede}</p>
</section>

<!-- The first service sits in the first viewport, so it enters with the CSS rise animation
     rather than waiting for the scroll-reveal script; the rest reveal as they scroll in. -->
<section class="services container" aria-label={t.advisory.servicesLabel}>
  {
    t.advisory.services.map((service, i) => (
      <div class:list={['service', i === 0 ? 'rise' : 'reveal']} style={`--i:${i}`}>
        <p class="num mono">{service.num}</p>
        <div>
          <h2>{service.title}</h2>
          <p class="text">{service.text}</p>
        </div>
      </div>
    ))
  }
</section>

<section class="track container">
  <div class="track-inner reveal">
    <p class="label">{t.advisory.trackRecordLabel}</p>
    {t.advisory.trackRecord.map((para) => <p class="track-text">{para}</p>)}
  </div>
</section>

<style>
  .head {
    padding-top: 64px;
  }

  h1 {
    font-size: var(--step-h2);
    line-height: 1.1;
    margin: 1rem 0 0.75rem;
  }

  .lede {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
    max-width: 40rem;
  }

  .services {
    margin-top: 2.75rem;
  }

  .service {
    border-top: 1px solid var(--line-strong);
    padding: 1.5rem 0;
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
  }

  .service:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .num {
    font-size: 0.75rem;
    color: var(--copper);
    padding-top: 0.4rem;
  }

  h2 {
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  .text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-body);
    margin: 0;
    max-width: 44rem;
  }

  .track {
    margin: 3.5rem 0 4.5rem;
  }

  .track-inner {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-top: 2px solid var(--copper);
    border-radius: var(--radius);
    padding: 2.125rem 2.5rem 2.375rem;
  }

  .track-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-body);
    margin: 0.875rem 0 0;
    max-width: 47.5rem;
  }

  @media (max-width: 820px) {
    .head {
      padding-top: 2.5rem;
    }

    .lede {
      font-size: 0.9375rem;
    }

    .services {
      margin-top: 1.75rem;
    }

    .service {
      grid-template-columns: 1fr;
      gap: 0.375rem;
      padding: 0.875rem 0;
    }

    .num {
      padding-top: 0;
    }

    h2 {
      font-size: 1.25rem;
    }

    .text {
      font-size: 0.9rem;
    }

    .track {
      margin: 1.75rem 0 2.5rem;
    }

    .track-inner {
      padding: 1.5rem 1.375rem 1.75rem;
    }

    .track-text {
      font-size: 0.9rem;
      margin-top: 0.75rem;
    }
  }
</style>
