---
import { getDict } from '../../i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section class="head container">
  <p class="eyebrow">{t.advisory.eyebrow}</p>
  <h1>{t.advisory.h1}</h1>
  <p class="lede">{t.advisory.lede}</p>
</section>

<section class="services container" aria-label={t.advisory.servicesLabel}>
  {
    t.advisory.services.map((service) => (
      <div class="service">
        <p class="num mono">{service.num}</p>
        <div>
          <h2>{service.title}</h2>
          <p class="text">{service.text}</p>
        </div>
      </div>
    ))
  }
</section>

<section class="track container">
  <div class="track-inner">
    <p class="eyebrow">{t.advisory.trackRecordLabel}</p>
    {t.advisory.trackRecord.map((para) => <p class="track-text">{para}</p>)}
  </div>
</section>

<p class="closing container">{t.advisory.closing}</p>

<style>
  .head {
    padding-top: 64px;
  }

  h1 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    margin: 14px 0 10px;
  }

  .lede {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 640px;
  }

  .services {
    margin-top: 44px;
  }

  .service {
    border-top: 1px solid var(--line-strong);
    padding: 20px 0;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
  }

  .service:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .num {
    font-size: 11.5px;
    color: var(--gold);
    padding-top: 3px;
  }

  h2 {
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .text {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-body);
    margin: 0;
    max-width: 700px;
  }

  .track {
    margin-top: 56px;
  }

  .track-inner {
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    padding: 34px 40px 38px;
  }

  .track-text {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-body);
    margin: 14px 0 0;
    max-width: 760px;
  }

  .closing {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    font-style: italic;
    margin: 40px 0 72px;
  }

  @media (max-width: 820px) {
    .head {
      padding-top: 40px;
    }

    h1 {
      font-size: 27px;
      line-height: 1.2;
      margin: 12px 0 8px;
    }

    .lede {
      font-size: 13.5px;
    }

    .services {
      margin-top: 28px;
    }

    .service {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 14px 0;
    }

    .num {
      font-size: 11px;
      padding-top: 0;
    }

    h2 {
      font-size: 16px;
    }

    .text {
      font-size: 13.5px;
    }

    .track {
      margin-top: 28px;
    }

    .track-inner {
      padding: 24px 22px 28px;
    }

    .track-text {
      font-size: 13.5px;
      margin-top: 12px;
    }

    .closing {
      font-size: 12.5px;
      margin: 28px 0 40px;
    }
  }
</style>
