---
import { getDict } from '../../i18n';
import en from '../../i18n/en';

interface Props {
  locale: string;
  /**
   * Per brief Section 4: AR/KO launch scope keeps Research in English with a
   * translated abstract paragraph per paper. Pass them here when applicable.
   */
  translatedAbstracts?: string[];
}

const { locale, translatedAbstracts } = Astro.props;
const t = getDict(locale);
// Research page content falls back to English where a locale ships core pages only.
const r = t.research ?? en.research!;
const pdfLabelFor = (i: number) =>
  t.research?.papers[i].pdfLabel ?? t.researchPdfLabels?.[i] ?? en.research!.papers[i].pdfLabel;
const ssrnLabelFor = (i: number) =>
  t.research?.papers[i].ssrnRecordLabel ?? t.researchSsrnRecordLabels?.[i] ?? en.research!.papers[i].ssrnRecordLabel;
---

<section class="head container">
  <p class="label rise" style="--i:0">{r.eyebrow}</p>
  <h1 class="rise" style="--i:1">{r.h1}</h1>
  <p class="lede rise" style="--i:2">{r.lede}</p>
</section>

<!-- 3.13 paper-tone reading section; the three-column layout is unchanged.
     The first card is in the first viewport, so it enters with the CSS rise animation and does
     not wait for the scroll-reveal script; the others reveal as they scroll in. -->
<section class="papers paper-tone container">
  {
    r.papers.map((paper, i) => (
      <article class:list={['paper', i === 0 ? 'rise' : 'reveal']} style={`--i:${i}`}>
        <p class="label meta paper-eyebrow">{paper.eyebrow}</p>
        <h2>{paper.title}</h2>
        <p class="thesis">{paper.thesis}</p>
        {translatedAbstracts?.[i] && (
          <p class="summary translated" lang={locale}>
            {translatedAbstracts[i]}
          </p>
        )}
        <div class="summary" lang={t.research ? locale : 'en'}>
          {paper.summary.map((sentence) => (
            <p>{sentence}</p>
          ))}
        </div>
        <div class="actions">
          <a
            class="btn btn--solid"
            href={paper.pdfHref}
            target="_blank"
            rel="noopener"
            data-umami-event="Paper Download"
            data-umami-event-paper={paper.pdfHref.split('/').pop()}
          >
            {pdfLabelFor(i)}
          </a>
          {paper.ssrnUrl ? (
            <a class="ssrn mono" href={paper.ssrnUrl} rel="noopener" target="_blank">
              {ssrnLabelFor(i)}
            </a>
          ) : (
            ssrnLabelFor(i) && <span class="ssrn ssrn-pending mono">{ssrnLabelFor(i)}</span>
          )}
        </div>
      </article>
    ))
  }
</section>

<style>
  .head {
    padding-top: 64px;
  }

  h1 {
    font-size: var(--step-h2);
    line-height: 1.1;
    margin: 1rem 0 0.75rem;
  }

  .lede {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
    max-width: 40rem;
  }

  .papers {
    margin-top: 2.75rem;
    padding-block: 3rem 4.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .paper:first-child {
    grid-row: span 2;
  }

  /* Cards in a row share a height; actions sit directly under the summary. */
  .paper {
    background: oklch(0.985 0.008 85);
    border: 1px solid oklch(0.2 0.02 255 / 12%);
    border-top: 2px solid var(--copper);
    border-radius: var(--radius);
    padding: 1.75rem 1.75rem 1.875rem;
    display: flex;
    flex-direction: column;
  }

  h2 {
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0.875rem 0 0.625rem;
    text-wrap: pretty;
    transition: color 0.5s;
  }

  .paper:hover h2 {
    color: var(--copper);
  }

  .thesis {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--paper-muted);
    margin: 0 0 1.125rem;
  }

  .summary p,
  .summary.translated {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--paper-fg);
    margin: 0 0 0.625rem;
    max-width: 47.5rem;
  }

  .summary.translated {
    color: var(--paper-muted);
  }

  /* The translated abstract keeps its locale's script font and direction. */
  .summary.translated:lang(ar) {
    font-family: 'Noto Naskh Arabic', sans-serif;
    direction: rtl;
    text-align: start;
  }

  .summary.translated:lang(ko) {
    font-family: 'Noto Sans KR', sans-serif;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 18px;
    padding-top: 12px;
  }

  /* On the paper ground the solid button's hover fill must stay dark, not paper-white. */
  .paper .btn--solid::before {
    background: var(--paper-fg);
  }

  .paper .btn--solid:hover {
    color: var(--paper);
  }

  .ssrn {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--paper-muted);
    text-decoration: none;
  }

  a.ssrn:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .head {
      padding-top: 2.5rem;
    }

    .lede {
      font-size: 0.9375rem;
    }

    .papers {
      margin-top: 1.75rem;
      padding-block: 1.75rem 2.5rem;
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .paper:first-child {
      grid-row: auto;
    }

    .paper {
      padding: 1.5rem 1.375rem 1.75rem;
    }

    h2 {
      font-size: 1.25rem;
      line-height: 1.3;
      margin: 0.75rem 0 0.5rem;
    }

    .thesis {
      font-size: 1rem;
      margin-bottom: 0.875rem;
    }

    .summary p,
    .summary.translated {
      font-size: 0.9rem;
    }
  }
</style>
