---
import { getDict } from '../../i18n';
import en from '../../i18n/en';
import { PAPER_PDF } from '../../config';

interface Props {
  locale: string;
  /**
   * Per brief Section 4: AR/KO launch scope keeps Research in English with a
   * translated abstract paragraph. Pass that paragraph here when applicable.
   */
  translatedAbstract?: string;
}

const { locale, translatedAbstract } = Astro.props;
const t = getDict(locale);
// Research page content falls back to English where a locale ships core pages only.
const r = t.research ?? en.research!;
const pdfLabel = t.research?.paper.pdfLabel ?? t.researchPdfLabel ?? en.research!.paper.pdfLabel;
const ssrnRecordLabel =
  t.research?.paper.ssrnRecordLabel ?? t.researchSsrnRecordLabel ?? en.research!.paper.ssrnRecordLabel;
---

<section class="head container">
  <p class="eyebrow">{r.eyebrow}</p>
  <h1>{r.h1}</h1>
  <p class="lede">{r.lede}</p>
</section>

<section class="papers container">
  <article class="paper">
    <p class="eyebrow paper-eyebrow">{r.paper.eyebrow}</p>
    <h2>{r.paper.title}</h2>
    <p class="thesis">{r.paper.thesis}</p>
    {translatedAbstract && <p class="summary translated" lang={locale}>{translatedAbstract}</p>}
    <div class="summary" lang="en">
      {r.paper.summary.map((sentence) => <p>{sentence}</p>)}
    </div>
    <div class="actions">
      <a class="btn" href={PAPER_PDF} target="_blank" rel="noopener">{pdfLabel}</a>
      {
        r.paper.ssrnUrl ? (
          <a class="ssrn mono" href={r.paper.ssrnUrl} rel="noopener" target="_blank">
            {ssrnRecordLabel}
          </a>
        ) : (
          <span class="ssrn ssrn-pending mono">{ssrnRecordLabel}</span>
        )
      }
    </div>
  </article>
</section>

<style>
  .head {
    padding-top: 64px;
  }

  h1 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    margin: 14px 0 10px;
  }

  .lede {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 640px;
  }

  .papers {
    margin: 44px 0 72px;
  }

  .paper {
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    padding: 34px 40px 38px;
  }

  .paper-eyebrow {
    letter-spacing: 0.2em;
  }

  h2 {
    font-size: 27px;
    font-weight: 600;
    line-height: 1.3;
    margin: 14px 0 10px;
    max-width: 840px;
    text-wrap: pretty;
  }

  .thesis {
    font-style: italic;
    font-size: 17px;
    color: var(--text-body);
    margin: 0 0 18px;
  }

  .summary p,
  .summary.translated {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-body);
    margin: 0 0 10px;
    max-width: 760px;
  }

  .summary.translated {
    color: var(--muted-hero);
  }

  /* The translated abstract keeps its locale's script font and direction. */
  .summary.translated:lang(ar) {
    font-family: 'Noto Naskh Arabic', sans-serif;
    direction: rtl;
    text-align: start;
  }

  .summary.translated:lang(ko) {
    font-family: 'Noto Sans KR', sans-serif;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 22px;
  }

  .btn {
    display: inline-block;
    background: var(--gold);
    color: var(--bg);
    font-weight: 600;
    font-size: 13.5px;
    letter-spacing: 0.02em;
    padding: 11px 22px;
    text-decoration: none;
  }

  .btn:hover {
    background: #e2b055;
  }

  .ssrn {
    display: inline-block;
    font-size: 12.5px;
    color: var(--gold);
    text-decoration: none;
  }

  a.ssrn:hover {
    text-decoration: underline;
  }

  .ssrn-pending {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .head {
      padding-top: 40px;
    }

    h1 {
      font-size: 27px;
      line-height: 1.2;
      margin: 12px 0 8px;
    }

    .lede {
      font-size: 13.5px;
    }

    .papers {
      margin: 28px 0 40px;
    }

    .paper {
      padding: 24px 22px 28px;
    }

    .paper-eyebrow {
      letter-spacing: 0.18em;
    }

    h2 {
      font-size: 18px;
      line-height: 1.35;
      margin: 12px 0 8px;
    }

    .thesis {
      font-size: 14.5px;
      margin-bottom: 14px;
    }

    .summary p,
    .summary.translated {
      font-size: 13.5px;
    }

    .ssrn {
      font-size: 11.5px;
    }
  }
</style>
