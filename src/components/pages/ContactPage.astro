---
import { getDict } from '../../i18n';
import { EMAIL, LINKEDIN_URL, CTA_MAILTO } from '../../config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section class="head container">
  <p class="eyebrow">{t.contact.eyebrow}</p>
  <h1>{t.contact.h1}</h1>
  <p class="lede">{t.contactLead}</p>
</section>

<section class="channels container">
  <div class="row">
    <p class="label eyebrow">{t.contact.emailLabel}</p>
    <a class="value" href={CTA_MAILTO}>{EMAIL}</a>
  </div>
  <div class="row">
    <p class="label eyebrow">{t.contact.linkedinLabel}</p>
    <a class="value" href={LINKEDIN_URL} rel="me noopener" target="_blank">{t.contact.linkedinLabel} ↗</a>
  </div>
  <a class="contact-cta" href={CTA_MAILTO}>{t.ctaLabel} <span class="cta-arrow" aria-hidden="true">→</span></a>
</section>

<style>
  .head {
    padding-top: 64px;
  }

  h1 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    margin: 14px 0 10px;
  }

  .lede {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 640px;
  }

  .contact-cta {
    display: inline-block;
    margin-top: 28px;
    background: var(--gold);
    color: var(--bg);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.02em;
    padding: 13px 26px;
    min-height: 44px;
    text-decoration: none;
  }

  .contact-cta:hover {
    background: #e2b055;
  }

  .cta-arrow {
    display: inline-block;
    margin-inline-start: 6px;
  }

  :global([dir='rtl']) .cta-arrow {
    transform: scaleX(-1);
  }

  .channels {
    margin: 44px 0 96px;
  }

  .row {
    border-top: 1px solid var(--line-strong);
    padding: 20px 0;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    align-items: baseline;
  }

  .row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .label {
    letter-spacing: 0.18em;
  }

  .value {
    font-size: 18px;
    color: var(--text);
    text-decoration: none;
  }

  .value:hover {
    color: var(--gold);
  }

  @media (max-width: 820px) {
    .head {
      padding-top: 40px;
    }

    h1 {
      font-size: 27px;
      line-height: 1.2;
      margin: 12px 0 8px;
    }

    .lede {
      font-size: 13.5px;
    }

    .channels {
      margin: 28px 0 56px;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 14px 0;
    }

    .value {
      font-size: 16px;
    }
  }
</style>
