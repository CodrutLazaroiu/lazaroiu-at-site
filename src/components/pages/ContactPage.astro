---
import { getDict } from '../../i18n';
import { EMAIL, LINKEDIN_URL, CTA_MAILTO } from '../../config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section class="head container">
  <p class="label rise" style="--i:0">{t.contact.eyebrow}</p>
  <h1 class="rise" style="--i:1">{t.contact.h1}</h1>
  <p class="lede rise" style="--i:2">{t.contactLead}</p>
</section>

<section class="channels container">
  <div class="row reveal" style="--i:0">
    <p class="label">{t.contact.emailLabel}</p>
    <a class="value link-draw" href={CTA_MAILTO} data-umami-event="Contact Click">{EMAIL}</a>
  </div>
  <div class="row reveal" style="--i:1">
    <p class="label">{t.contact.linkedinLabel}</p>
    <a class="value link-draw" href={LINKEDIN_URL} rel="me noopener" target="_blank" data-umami-event="LinkedIn Click">{t.contact.linkedinLabel} ↗</a>
  </div>
  <p class="cta-row reveal" style="--i:2">
    <a class="btn btn--solid" data-magnetic href={CTA_MAILTO} data-umami-event="Contact Click">{t.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  .head {
    padding-top: 64px;
  }

  h1 {
    font-size: var(--step-h2);
    line-height: 1.1;
    margin: 1rem 0 0.75rem;
  }

  .lede {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
    max-width: 40rem;
  }

  .cta-row {
    margin: 2rem 0 0;
  }

  .channels {
    margin: 2.75rem 0 6rem;
  }

  .row {
    border-top: 1px solid var(--line-strong);
    padding: 1.25rem 0;
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
  }

  .row + .row {
    border-bottom: 1px solid var(--line-strong);
  }

  .value {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--fg);
  }

  .value:hover {
    color: var(--copper);
  }

  @media (max-width: 820px) {
    .head {
      padding-top: 2.5rem;
    }

    .lede {
      font-size: 0.9375rem;
    }

    .channels {
      margin: 1.75rem 0 3.5rem;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 0.375rem;
      padding: 0.875rem 0;
    }

    .value {
      font-size: 1.125rem;
    }
  }
</style>
