      <rect x="426" y="268" width="9" height="3" fill="#D9A441" opacity="0.5"></rect>
      <rect x="437" y="268" width="6" height="3" fill="#D9A441" opacity="0.25"></rect>
    </g>

    <!-- N6 delivery hub · warn -->
    <g>
      <rect x="536" y="200" width="34" height="34" rx="8" fill="#16233D" stroke="rgba(232,234,240,0.22)"></rect>
      <path d="M543 224 h9 M552 224 v-10 h9 M552 218 h6" stroke="#E8EAF0" stroke-width="1.5" opacity="0.75"></path>
      <circle cx="570" cy="200" r="9.5" fill="#0C1626" stroke="#D9A441" stroke-width="2.5"></circle>
