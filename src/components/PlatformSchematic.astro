      <rect x="40" y="382" width="38" height="4" rx="2" fill="rgba(232,234,240,0.13)"></rect>
      <rect x="98" y="382" width="20" height="4" fill="#C75B12" opacity="0.75"></rect>
      <rect x="120" y="382" width="26" height="4" fill="#D9A441" opacity="0.7"></rect>
