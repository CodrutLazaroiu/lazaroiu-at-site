<style>
  .schematic-wrap {
    overflow: hidden;
    filter: drop-shadow(0 10px 34px rgba(0, 0, 0, 0.45));
  }

  .schematic {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Mirror for RTL locales, like the corridor motif */
  :global([dir='rtl']) .schematic {
    transform: scaleX(-1);
  }
</style>
