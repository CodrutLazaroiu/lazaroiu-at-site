      <path d="M140 300 h20" stroke="#E8EAF0" stroke-width="1.6" opacity="0.75"></path>
      <circle cx="150" cy="294" r="4" stroke="#E8EAF0" stroke-width="1.5" opacity="0.75"></circle>
