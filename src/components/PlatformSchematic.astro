    <g>
      <rect x="48" y="78" width="118" height="128" rx="8" fill="#101C33" stroke="rgba(232,234,240,0.14)"></rect>
      <rect x="60" y="90" width="56" height="4.5" rx="2" fill="rgba(232,234,240,0.22)"></rect>
      <g transform="rotate(-90 107 140)">
        <circle cx="107" cy="140" r="22" stroke="rgba(232,234,240,0.12)" stroke-width="9"></circle>
        <circle cx="107" cy="140" r="22" stroke="#D9A441" stroke-width="9" opacity="0.9"
