---
// Unbranded product-window vignette: a dark application frame containing a
// stylized risk-console map — terrain zones, a transport route with a
// stressed segment, station badges with status rings and tier bars, a risk
// panel, and a group-wide shield. No names, no legible figures, no logo.
// Purely decorative; drawn entirely in the site's design language.
---

<div class="schematic-wrap" aria-hidden="true">
  <svg viewBox="0 0 720 470" fill="none" class="schematic">
    <defs>
      <clipPath id="map-clip">
        <rect x="12" y="50" width="696" height="406" rx="8"></rect>
      </clipPath>
      <radialGradient id="glow" cx="0.5" cy="0.45" r="0.6">
        <stop offset="0%" stop-color="#D9A441" stop-opacity="0.07"></stop>
        <stop offset="100%" stop-color="#D9A441" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <!-- window frame -->
    <rect x="1" y="1" width="718" height="468" rx="12" fill="#101C33" stroke="rgba(232,234,240,0.16)"></rect>
    <circle cx="26" cy="20" r="4.5" fill="rgba(232,234,240,0.18)"></circle>
    <circle cx="46" cy="20" r="4.5" fill="rgba(232,234,240,0.12)"></circle>
    <circle cx="66" cy="20" r="4.5" fill="rgba(232,234,240,0.08)"></circle>
    <rect x="96" y="12" width="240" height="16" rx="8" fill="rgba(255,255,255,0.045)"></rect>
    <rect x="640" y="12" width="54" height="16" rx="8" fill="rgba(217,164,65,0.12)"></rect>
    <line x1="1" y1="39" x2="719" y2="39" stroke="rgba(232,234,240,0.1)"></line>

    <!-- map canvas -->
    <g clip-path="url(#map-clip)">
      <rect x="12" y="50" width="696" height="406" fill="#0D1830"></rect>

      <!-- terrain zones -->
      <path d="M12 50 H160 C185 160 140 280 175 456 H12 Z" fill="#13233F"></path>
      <path d="M215 456 C255 340 260 200 390 175 C500 155 560 230 545 456 Z" fill="#121D34"></path>
      <path d="M520 456 C555 310 660 330 708 305 V456 H520 Z" fill="#0F1F31"></path>

      <!-- water lines -->
      <path d="M35 130 q11 -8 22 0 t22 0" stroke="rgba(232,234,240,0.06)" stroke-width="2"></path>
      <path d="M50 210 q11 -8 22 0 t22 0" stroke="rgba(232,234,240,0.06)" stroke-width="2"></path>
      <path d="M32 300 q11 -8 22 0 t22 0" stroke="rgba(232,234,240,0.06)" stroke-width="2"></path>
      <path d="M55 385 q11 -8 22 0 t22 0" stroke="rgba(232,234,240,0.06)" stroke-width="2"></path>

      <!-- mountains -->
      <path d="M300 330 l38 -68 l38 68 z" fill="rgba(232,234,240,0.03)" stroke="rgba(232,234,240,0.09)"></path>
      <path d="M355 345 l30 -52 l30 52 z" fill="rgba(232,234,240,0.02)" stroke="rgba(232,234,240,0.07)"></path>
      <path d="M395 400 l26 -44 l26 44 z" fill="rgba(232,234,240,0.02)" stroke="rgba(232,234,240,0.06)"></path>

      <!-- forest -->
      <g fill="rgba(232,234,240,0.05)">
        <path d="M580 390 l7 -14 l7 14 z"></path>
        <path d="M610 370 l7 -14 l7 14 z"></path>
        <path d="M640 400 l7 -14 l7 14 z"></path>
        <path d="M665 360 l7 -14 l7 14 z"></path>
        <path d="M600 425 l7 -14 l7 14 z"></path>
        <path d="M655 430 l7 -14 l7 14 z"></path>
      </g>

      <!-- ambient glow -->
      <circle cx="350" cy="230" r="230" fill="url(#glow)"></circle>

      <!-- route: base pipe + stressed segment -->
      <path
        d="M-5 310 C 60 295, 100 305, 150 296 C 215 285, 240 235, 300 215 C 345 200, 375 240, 430 252 C 485 264, 520 228, 575 232 C 620 236, 660 255, 725 260"
        stroke="rgba(232,234,240,0.18)"
        stroke-width="6"
        stroke-linecap="round"></path>
      <path
        d="M240 240 C 265 224, 280 219, 300 215 C 330 205, 350 224, 385 240"
        stroke="#C75B12"
        stroke-width="6"
        stroke-linecap="round"
        opacity="0.6"></path>
      <path d="M700 258 h30" stroke="rgba(232,234,240,0.14)" stroke-width="3" stroke-dasharray="3 6"></path>
    </g>

    <!-- station badges: disc + facility glyph + status ring + label/tier bars -->
    <!-- N1 marine terminal · warn -->
    <g>
      <rect x="43" y="273" width="34" height="34" rx="8" fill="#16233D" stroke="rgba(232,234,240,0.22)"></rect>
      <path d="M52 296 h16 l-3 4 h-10 z" stroke="#E8EAF0" stroke-width="1.5" opacity="0.75"></path>
      <path d="M58 296 v-8 M64 296 v-6" stroke="#E8EAF0" stroke-width="1.5" opacity="0.75"></path>
