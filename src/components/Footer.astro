---
import { getDict } from '../i18n';
import { EMAIL, LINKEDIN_URL } from '../config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  /** Locale-less path of the current page, e.g. '/advisory/'. */
  path: string;
  /** Locales in which this page exists; switcher links only to these. */
  alternates: string[];
}

const { locale, path, alternates } = Astro.props;
const t = getDict(locale);
---

<footer class="site-footer">
  <div class="group">
    <a href={`mailto:${EMAIL}`} class="light">{EMAIL}</a>
    <span aria-hidden="true">·</span>
    <a href={LINKEDIN_URL} class="light" rel="me noopener" target="_blank">{t.footer.linkedin} ↗</a>
  </div>
  <div class="group">
    <a href="/impressum/">{t.footer.impressum}</a>
    <span aria-hidden="true">·</span>
    <a href="/datenschutz/">{t.footer.datenschutz}</a>
  </div>
  <LanguageSwitcher locale={locale} path={path} alternates={alternates} variant="footer" />
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 22px var(--pad-x) 38px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .group {
    display: flex;
    gap: 8px;
  }

  a {
    color: var(--muted);
  }

  a.light {
    color: var(--text);
  }

  @media (max-width: 820px) {
    .site-footer {
      padding: 16px var(--pad-x) 30px;
      flex-direction: column;
      gap: 8px;
      font-size: 12px;
    }
  }
</style>
