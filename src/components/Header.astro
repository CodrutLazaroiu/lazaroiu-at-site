---
import { getDict, localePath } from '../i18n';
import { OWNER } from '../config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  /** Locale-less path of the current page, e.g. '/advisory/'. */
  path: string;
  /** Locales in which this page exists. */
  alternates: string[];
  active?: 'advisory' | 'research' | 'about' | 'contact';
}

const { locale, path, alternates, active } = Astro.props;
const t = getDict(locale);

const items = [
  { key: 'advisory', label: t.nav.advisory, href: localePath(locale, '/advisory/') },
  { key: 'research', label: t.nav.research, href: localePath(locale, '/research/') },
  { key: 'about', label: t.nav.about, href: localePath(locale, '/about/') },
  { key: 'contact', label: t.nav.contact, href: localePath(locale, '/contact/') },
] as const;
---

<header class="site-header">
  <a class="wordmark link-draw" href={localePath(locale, '/')}>{OWNER}</a>
  <div class="right">
    <nav aria-label="Main">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={['link-draw', { active: active === item.key }]}
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher locale={locale} path={path} alternates={alternates} variant="header" />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem var(--pad-x);
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  nav {
    display: flex;
    gap: 1.75rem;
  }

  nav a {
    font: 500 var(--step-label) / 1.3 var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-block: 0.25rem;
  }

  nav a:hover {
    color: var(--fg);
  }

  nav a.active {
    color: var(--copper);
    background-size: 100% 1px;
  }

  @media (max-width: 820px) {
    .site-header {
      display: block;
      padding: 1.125rem var(--pad-x) 0.875rem;
    }

    .wordmark {
      font-size: 1.125rem;
    }

    /* The switcher joins the wrapped menu row on mobile. */
    .right {
      margin-top: 0.75rem;
      gap: 1.125rem;
      flex-wrap: wrap;
      align-items: baseline;
    }

    nav {
      gap: 1.125rem;
      flex-wrap: wrap;
    }

    nav a {
      font-size: 0.6875rem;
      letter-spacing: 0.16em;
    }
  }
</style>
