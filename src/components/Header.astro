---
import { getDict, localePath } from '../i18n';
import { OWNER } from '../config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  /** Locale-less path of the current page, e.g. '/advisory/'. */
  path: string;
  /** Locales in which this page exists. */
  alternates: string[];
  active?: 'advisory' | 'research' | 'about' | 'contact';
}

const { locale, path, alternates, active } = Astro.props;
const t = getDict(locale);

const items = [
  { key: 'advisory', label: t.nav.advisory, href: localePath(locale, '/advisory/') },
  { key: 'research', label: t.nav.research, href: localePath(locale, '/research/') },
  { key: 'about', label: t.nav.about, href: localePath(locale, '/about/') },
  { key: 'contact', label: t.nav.contact, href: localePath(locale, '/contact/') },
] as const;
---

<header class="site-header">
  <a class="wordmark" href={localePath(locale, '/')}>{OWNER}</a>
  <div class="right">
    <nav aria-label="Main">
      {
        items.map((item) => (
          <a href={item.href} class:list={{ active: active === item.key }} aria-current={active === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher locale={locale} path={path} alternates={alternates} variant="header" />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px var(--pad-x);
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  nav {
    display: flex;
    gap: 30px;
    font-size: 12.5px;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a.active {
    color: var(--gold);
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
  }

  nav a.active:hover {
    color: var(--gold);
  }

  @media (max-width: 820px) {
    .site-header {
      display: block;
      padding: 18px var(--pad-x) 14px;
    }

    .wordmark {
      font-size: 13.5px;
    }

    /* The switcher joins the wrapped menu row on mobile. */
    .right {
      margin-top: 10px;
      gap: 18px;
      flex-wrap: wrap;
      align-items: baseline;
    }

    nav {
      gap: 18px;
      font-size: 11.5px;
      flex-wrap: wrap;
    }
  }
</style>
