---
// The corridor motif from the D3 renders: a single stepped route line with
// four nodes, drawn behind the hero. Desktop and mobile geometries are the
// exact paths from the selected renders.
---

<svg
  class="corridor corridor-desktop"
  viewBox="0 0 1280 420"
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
>
  <path d="M-10 360 H360 L480 250 H840 L950 150 H1300" stroke="#D9A441" stroke-width="1.3" opacity="0.45"></path>
  <circle cx="360" cy="360" r="3.5" fill="#D9A441" opacity="0.8"></circle>
  <circle cx="480" cy="250" r="3.5" fill="#D9A441" opacity="0.8"></circle>
  <circle cx="840" cy="250" r="3.5" fill="#D9A441" opacity="0.8"></circle>
  <circle cx="950" cy="150" r="3.5" fill="#D9A441" opacity="0.8"></circle>
</svg>

<svg
  class="corridor corridor-mobile"
  viewBox="0 0 390 320"
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
>
  <path d="M-10 270 H120 L190 190 H300 L345 120 H400" stroke="#D9A441" stroke-width="1.2" opacity="0.4"></path>
  <circle cx="120" cy="270" r="3" fill="#D9A441" opacity="0.75"></circle>
  <circle cx="190" cy="190" r="3" fill="#D9A441" opacity="0.75"></circle>
  <circle cx="300" cy="190" r="3" fill="#D9A441" opacity="0.75"></circle>
  <circle cx="345" cy="120" r="3" fill="#D9A441" opacity="0.75"></circle>
</svg>

<style>
  .corridor {
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    width: 100%;
    height: 100%;
  }

  /* Mirror the route for RTL locales */
  :global([dir='rtl']) .corridor {
    transform: scaleX(-1);
  }

  .corridor-mobile {
    display: none;
  }

  @media (max-width: 820px) {
    .corridor-desktop {
      display: none;
    }

    .corridor-mobile {
      display: block;
    }
  }
</style>
