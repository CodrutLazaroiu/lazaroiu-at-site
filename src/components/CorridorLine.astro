---
// The corridor motif from the D3 renders: a single stepped route line with
// four nodes. It renders inside its own full-width band (see HomePage), so it
// can never intersect a text block at any breakpoint.
---

<svg
  class="corridor corridor-desktop"
  viewBox="0 0 1280 140"
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
>
  <path d="M-10 118 H360 L480 72 H840 L950 26 H1300" stroke="#D9A441" stroke-width="1.3" opacity="0.45"></path>
  <circle cx="360" cy="118" r="3.5" fill="#D9A441" opacity="0.8"></circle>
  <circle cx="480" cy="72" r="3.5" fill="#D9A441" opacity="0.8"></circle>
  <circle cx="840" cy="72" r="3.5" fill="#D9A441" opacity="0.8"></circle>
  <circle cx="950" cy="26" r="3.5" fill="#D9A441" opacity="0.8"></circle>
</svg>

<svg
  class="corridor corridor-mobile"
  viewBox="0 0 390 90"
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
>
  <path d="M-10 74 H120 L190 46 H300 L345 20 H400" stroke="#D9A441" stroke-width="1.2" opacity="0.4"></path>
  <circle cx="120" cy="74" r="3" fill="#D9A441" opacity="0.75"></circle>
  <circle cx="190" cy="46" r="3" fill="#D9A441" opacity="0.75"></circle>
  <circle cx="300" cy="46" r="3" fill="#D9A441" opacity="0.75"></circle>
  <circle cx="345" cy="20" r="3" fill="#D9A441" opacity="0.75"></circle>
</svg>

<style>
  .corridor {
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    width: 100%;
    height: 100%;
  }

  /* Mirror the route for RTL locales */
  :global([dir='rtl']) .corridor {
    transform: scaleX(-1);
  }

  .corridor-mobile {
    display: none;
  }

  @media (max-width: 820px) {
    .corridor-desktop {
      display: none;
    }

    .corridor-mobile {
      display: block;
    }
  }
</style>
